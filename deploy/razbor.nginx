# Разбор: демо для жюри Академии Финтеха -> python на 127.0.0.1:8097, вход по паролю
server {
    listen 80;
    listen [::]:80;
    server_name razbor.paira.ru;
    client_max_body_size 64k;
    auth_basic "Razbor demo";
    auth_basic_user_file /etc/nginx/razbor.htpasswd;
    location / {
        proxy_pass http://127.0.0.1:8097;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
    }
}
